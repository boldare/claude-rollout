{
  "name": "claude-rollout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Drives a multi-PR plan with headless Claude Code agents: briefs, implementation, independent verification, a merge gate and ordered merges.",
  "bin": {
    "rollout": "bin/rollout.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:mutations": "node test/mutations.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.6.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
