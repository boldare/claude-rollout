{
  "type": "object",
  "properties": {
    "verdict": { "type": "string", "enum": ["PASS", "FAIL"] },
    "sha": { "type": "string", "description": "Full SHA you verified (git rev-parse HEAD)." },
    "summary": { "type": "string" },
    "checklist": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": { "type": "string" },
          "status": { "type": "string", "enum": ["pass", "fail", "unverifiable"] },
          "evidence": { "type": "string" }
        },
        "required": ["item", "status", "evidence"]
      }
    },
    "blocking": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Real defects or unmet checklist items, each with file:line or command evidence. A project criterion that does not pass goes into criteria only."
    },
    "nonBlocking": { "type": "array", "items": { "type": "string" } },
    "recheck": {
      "type": "array",
      "description": "One entry per finding listed under \"Findings to re-check\", empty when the prompt lists none.",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "status": { "type": "string", "enum": ["resolved", "open", "wrong"] },
          "evidence": { "type": "string" }
        },
        "required": ["id", "status", "evidence"]
      }
    },
    "criteria": {
      "type": "array",
      "description": "One entry per criterion listed under \"Project criteria\", empty when the prompt lists none.",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "result": { "type": "string", "enum": ["pass", "fail", "unverifiable"] },
          "evidence": { "type": "string" }
        },
        "required": ["id", "result", "evidence"]
      }
    }
  },
  "required": ["verdict", "sha", "summary", "checklist", "blocking", "nonBlocking", "recheck", "criteria"]
}
